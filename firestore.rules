rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Every document used by the app is scoped below its authenticated owner.
    // This also denies access to any top-level collections not explicitly allowed.
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);

      match /projects/{projectId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /work_logs/{logId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /todos/{todoId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /notes/{noteId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Vault documents contain client-side ciphertext only. Ownership protects
      // document access; the Master Password never reaches Firestore.
      match /vault_meta/{metaId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /vault_items/{itemId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /active_session/{sessionId} {
        allow read, create, delete: if isOwner(userId);
        // Only the current app's explicit Pause action may introduce pausedAt.
        // This blocks stale clients that contained the old automatic-pause bug.
        allow update: if isOwner(userId)
          && (!(request.resource.data.pausedAt != null && resource.data.pausedAt == null)
            || request.resource.data.pauseReason == 'manual');
      }

      match /settings/{settingId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /routines/{routineId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /routine_logs/{routineLogId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /finance_accounts/{accountId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /finance_transactions/{transactionId} {
        allow read, create, update, delete: if isOwner(userId);
      }
      match /finance_assets/{assetId} { allow read, create, update, delete: if isOwner(userId); }
      match /finance_goals/{goalId} { allow read, create, update, delete: if isOwner(userId); }
      match /finance_recurring/{itemId} { allow read, create, update, delete: if isOwner(userId); }
      match /finance_budgets/{budgetId} { allow read, create, update, delete: if isOwner(userId); }
    }
  }
}
